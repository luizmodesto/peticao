# =========================================================================
# VARIÁVEIS DE AMBIENTE - PETIÇÃO NACIONAL PELA TRANSPARÊNCIA ELEITORAL
# =========================================================================
# Configure estas variáveis no arquivo .env.local e na aba "Environment Variables" da Vercel.

# 1. Supabase - Conexão Pública (Frontend / Client Components)
NEXT_PUBLIC_SUPABASE_URL=https://hbwianqvbhzgxfihykhh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_3W-JL4X6nyJS4kqn2IBgYg_ngSRit_f

# 2. Supabase - Chave de Serviço Admin (Backend / Server Actions / API Routes)
# Obtida no painel Supabase: Project Settings -> API -> Project API Keys -> service_role (secret)
# Esta chave NUNCA deve ter o prefixo NEXT_PUBLIC_ para não ser exposta no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secret-aqui

# 3. Resend - Envio de E-mails Transacionais
# Obtida no painel Resend: resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# 4. Remetente Oficial do E-mail
EMAIL_FROM=Petição Nacional <contato@peticaonacional.online>

# 5. URL da Aplicação em Produção (Opcional para links nos e-mails)
NEXT_PUBLIC_SITE_URL=https://peticaonacional.online

# 6. Conexão direta PostgreSQL (Opcional, usada apenas para scripts locais de migração)
DATABASE_URL=postgresql://postgres:senha@db.hbwianqvbhzgxfihykhh.supabase.co:5432/postgres
